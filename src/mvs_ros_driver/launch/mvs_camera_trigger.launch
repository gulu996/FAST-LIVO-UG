<launch>
  <arg name="mvs_library_dir" default="/opt/MVS/lib/aarch64"/>
  <arg name="timeshare_path" default="$(env HOME)/timeshare"/>
  <arg name="rviz_enable" default="true"/>

  <node pkg="mvs_ros_driver"
        type="grabImgWithTrigger"
        name="mvs_camera_trigger"
        args="$(find mvs_ros_driver)/config/left_camera_trigger.yaml"
        respawn="true"
        output="screen">
    <env name="LD_LIBRARY_PATH"
         value="$(arg mvs_library_dir):$(optenv LD_LIBRARY_PATH)"/>
    <param name="timeshare_path" value="$(arg timeshare_path)"/>
  </node>

  <group if="$(arg rviz_enable)">
    <node pkg="rviz"
          type="rviz"
          name="rviz"
          args="-d $(find mvs_ros_driver)/rviz_cfg/mvs_camera.rviz"/>
  </group>
</launch>
