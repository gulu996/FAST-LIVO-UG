<launch>
  <!-- Visualization companion for the dataset runner, on the same ROS master. -->
  <arg name="rviz_config" default="$(find fast_livo)/rviz_cfg/rtk_slam_dataset.rviz" />

  <!-- The raw backend odometry and the frontend cloud use the same unchanged
       frontend coordinates, named odom and camera_init respectively.
       The backend already publishes map -> odom; this joins their frame names.
       This identity alias is only for the RTK-SLAM configuration without UWB
       output correction. It must not be used with a different odom convention. -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="rtk_slam_frontend_frame_alias" args="0 0 0 0 0 0 odom camera_init" />
  <node pkg="rviz" type="rviz" name="rtk_slam_rviz" output="screen"
        args="-d $(arg rviz_config)" />
</launch>
