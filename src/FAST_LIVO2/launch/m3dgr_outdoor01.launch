<launch>
  <!-- ==================== 基本参数 ==================== -->
  <arg name="cmd_name" default="" />
  <arg name="rviz" default="true" />

  <arg name="play_bag" default="true" />
  <arg name="use_sim_time" default="true" />

  <arg name="bag"
       default="/media/gulu/一只沙糖桔/Outdoor01/Outdoor01.bag" />
  <arg name="bag_start" default="0.0" />

  <!-- GNSS融合第一次测试建议使用1.0，不要先用3倍速 -->
  <arg name="bag_rate" default="1.0" />
  <arg name="bag_delay" default="2.0" />
  <arg name="bag_queue" default="10000" />

  <arg name="debug_prefix" default="" />

  <!-- ==================== GNSS / RTK后端开关 ==================== -->
  <arg name="gnss_adapter_enable" default="true" />
  <arg name="rtk_backend_enable" default="true" />

  <arg name="gnss_adapter_config_file"
       default="$(find fast_livo)/config/m3dgr/gnss_adapter_outdoor01.yaml" />

  <arg name="rtk_backend_config_file"
       default="$(find fast_livo)/config/m3dgr/rtk_fixed_lag_backend_outdoor01.yaml" />

  <arg name="gnss_input_topic"
       default="/ublox_driver/receiver_pvt" />

  <arg name="gnss_output_odom_topic"
       default="/gnss/enu_odom" />

  <arg name="gnss_output_status_topic"
       default="/gnss/status" />

  <!-- ==================== ROS时间 ==================== -->
  <param name="/use_sim_time" value="$(arg use_sim_time)" />
  <!-- Clear a stale value before any GNSS logging node starts. -->
  <param name="/fast_livo/run_log_directory" value="__PENDING__" />

  <!-- ==================== FAST-LIVO2配置 ==================== -->
  <rosparam command="load"
            file="$(find fast_livo)/config/m3dgr/mid360.yaml" />

  <param name="/bag_start_offset" value="$(arg bag_start)" />

  <!-- ==================== GNSS适配层 ==================== -->
  <group if="$(arg gnss_adapter_enable)">
    <include file="$(find fast_livo)/launch/gnss_adapter.launch">
      <arg name="config_file"
           value="$(arg gnss_adapter_config_file)" />

      <arg name="input_topic"
           value="$(arg gnss_input_topic)" />

      <arg name="output_odom_topic"
           value="$(arg gnss_output_odom_topic)" />

      <arg name="output_status_topic"
           value="$(arg gnss_output_status_topic)" />
    </include>
  </group>

  <!-- ==================== 固定时滞GNSS后端 ==================== -->
  <group if="$(arg rtk_backend_enable)">
    <include file="$(find fast_livo)/launch/rtk_fixed_lag_backend.launch">
      <arg name="config_file"
           value="$(arg rtk_backend_config_file)" />
    </include>
  </group>

  <!-- ==================== 压缩图像转原始图像 ==================== -->
  <node pkg="image_transport"
        type="republish"
        name="republish_color_compressed_to_raw"
        args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw"
        output="screen"
        respawn="true" />

  <!-- ==================== FAST-LIVO2主节点 ==================== -->
  <node launch-prefix="$(arg debug_prefix)"
        pkg="fast_livo"
        type="fastlivo_mapping"
        name="laserMapping"
        output="screen">

    <param name="save_path"
           type="string"
           value="$(arg cmd_name)" />

    <rosparam file="$(find fast_livo)/config/m3dgr/camera_pinhole_mid360.yaml" />
  </node>

  <!-- ==================== RViz ==================== -->
  <group if="$(arg rviz)">
    <node launch-prefix="nice"
          pkg="rviz"
          type="rviz"
          name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>

  <!-- ==================== rosbag播放 ==================== -->
  <!-- 放在最后，并继续使用wait-for-subscribers与delay -->
<node if="$(arg play_bag)"
      pkg="rosbag"
      type="play"
      name="outdoor01_bag"
      output="screen"
      args="--clock
            --wait-for-subscribers
            --delay=$(arg bag_delay)
            --queue=$(arg bag_queue)
            -r $(arg bag_rate)
            -s $(arg bag_start)
            $(arg bag)
            --topics
            /camera/color/image_raw/compressed
            /livox/mid360/lidar
            /livox/mid360/imu
            /ublox_driver/receiver_pvt" />
</launch>
