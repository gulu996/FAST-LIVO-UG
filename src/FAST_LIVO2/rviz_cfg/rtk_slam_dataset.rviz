Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: camera_init
    Frame Rate: 20
  Displays:
    - Class: rviz/PointCloud2
      Name: LiDAR map
      Enabled: true
      Topic: /cloud_registered
      Queue Size: 10
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 255
      Use rainbow: true
      Invert Rainbow: false
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Decay Time: 1800
      Selectable: false
      Use Fixed Frame: true
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Name: LIVO trajectory
      Enabled: true
      Topic: /mapping/path
      Alpha: 1
      Color: 120; 135; 145
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.07
      Pose Style: None
      Queue Size: 10
      Value: true
    - Class: rviz/Path
      Name: GNSS fusion recent 20 s
      Enabled: true
      Topic: /rtk_backend/optimized_path
      Alpha: 1
      Color: 24; 121; 189
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.12
      Pose Style: None
      Queue Size: 10
      Value: true
    - Class: rviz/Axes
      Name: Current pose
      Enabled: true
      Reference Frame: aft_mapped
      Length: 1
      Radius: 0.06
      Value: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 90
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.15
      Yaw: 0.75
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1600
  Height: 1000
