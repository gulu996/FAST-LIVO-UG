<?xml version="1.0"?>
<package format="2">
  <name>gnss_serial_driver</name>
  <version>0.1.0</version>
  <description>Independent GNSS serial, replay, parsing, LOCAL timestamping and ENU adapter.</description>
  <maintainer email="gulu@example.com">gulu</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>eigen</build_depend>
  <build_depend>gnss_comm</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>roscpp</build_depend>
