<launch>
  <param name="/use_sim_time" value="false"/>

  <arg name="enable_time_bridge" default="true"/>
  <arg name="enable_livox" default="true"/>
  <arg name="enable_camera" default="true"/>
  <arg name="enable_gnss" default="true"/>
  <arg name="enable_gnss_adapter" default="true"/>
  <arg name="enable_uwb" default="true"/>

  <arg name="mcu_input_mode" default="serial"/>
  <arg name="mcu_port" default="/dev/sensor_mcu"/>
  <arg name="mcu_baud" default="115200"/>
  <arg name="gnss_source" default="serial"/>
  <arg name="gnss_port" default="/dev/gnss"/>
  <arg name="gnss_baud" default="921600"/>
  <arg name="gnss_replay_file" default=""/>
  <arg name="uwb_source" default="serial"/>
  <arg name="uwb_port" default="/dev/uwb"/>
  <arg name="uwb_baud" default="115200"/>
  <arg name="uwb_dtr" default="true"/>
  <arg name="uwb_rts" default="false"/>
  <arg name="uwb_replay_file" default=""/>
  <arg name="uwb_parser_mode" default="distance_round5"/>
  <arg name="uwb_distance_lines_per_round" default="5"/>
  <arg name="uwb_round_timeout_s" default="2.0"/>
  <arg name="uwb_round_timestamp_policy" default="first_distance_line"/>
  <arg name="record_profile" default="both"/>
  <arg name="output_dir" default="/tmp"/>
  <arg name="sim_start_without_gnss_s" default="86400.0"/>  
  <arg name="mvs_library_dir" default="/opt/MVS/lib/aarch64"/>
  <arg name="timeshare_path" default="$(env HOME)/timeshare"/>
  <arg name="imu_timeshare_path" default="$(env HOME)/timeshare_imu"/>
  <arg name="imu_anchor_enable" default="true"/>
  <arg name="imu_anchor_min_ready_samples" default="3"/>
  <arg name="imu_anchor_uncertainty_ns" default="10000000"/>
  <arg name="imu_anchor_max_stamp_step_s" default="0.1"/>
  <arg name="imu_anchor_warn_age_s" default="0.020"/>
  <arg name="imu_anchor_max_age_s" default="0.100"/>
  <arg name="uwb_timestamp_mode" default="livox_imu_anchor"/>
  <arg name="gnss_timestamp_mode" default="livox_imu_anchor"/>
  <arg name="uwb_time_offset_s" default="0.0"/>
  <arg name="gnss_time_offset_s" default="0.0"/>

  <group if="$(arg enable_time_bridge)">
    <node pkg="sensor_time_bridge"
          type="sensor_time_bridge_node"
          name="sensor_time_bridge"
          output="screen"
          required="true">
      <param name="input_mode" value="$(arg mcu_input_mode)"/>
      <param name="serial_port" value="$(arg mcu_port)"/>
      <param name="serial_baud" value="$(arg mcu_baud)"/>
    </node>

    <group if="$(eval arg('mcu_input_mode') == 'simulation')">
      <node pkg="sensor_time_bridge"
            type="mcu_event_simulator"
            name="mcu_event_simulator"
            output="screen"
            required="true">
        <param name="local_tick_hz" value="1000000"/>
        <param name="clock_error_ppm" value="50.0"/>
        <param name="camera_rate_hz" value="10.0"/>
        <param name="local_pps_rate_hz" value="1.0"/>
        <param name="start_without_gnss_s"
               value="$(arg sim_start_without_gnss_s)"/>
      </node>
    </group>
  </group>

  <group if="$(arg enable_livox)">
    <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch">
      <arg name="rosbag_enable" value="false"/>
      <arg name="rviz_enable" value="false"/>
      <arg name="timeshare_path" value="$(arg timeshare_path)"/>
      <arg name="imu_anchor_enable" value="$(arg imu_anchor_enable)"/>
      <arg name="imu_timeshare_path" value="$(arg imu_timeshare_path)"/>
      <arg name="imu_anchor_min_ready_samples"
           value="$(arg imu_anchor_min_ready_samples)"/>
      <arg name="imu_anchor_uncertainty_ns"
           value="$(arg imu_anchor_uncertainty_ns)"/>
      <arg name="imu_anchor_max_stamp_step_s"
           value="$(arg imu_anchor_max_stamp_step_s)"/>
    </include>
  </group>

  <group if="$(arg enable_camera)">
    <include file="$(find mvs_ros_driver)/launch/mvs_camera_trigger.launch">
      <arg name="mvs_library_dir" value="$(arg mvs_library_dir)"/>
      <arg name="timeshare_path" value="$(arg timeshare_path)"/>
      <arg name="rviz_enable" value="false"/>
    </include>
  </group>

  <group if="$(arg enable_gnss)">
    <include file="$(find gnss_serial_driver)/launch/gnss_serial.launch">
      <arg name="source" value="$(arg gnss_source)"/>
      <arg name="port" value="$(arg gnss_port)"/>
      <arg name="baud" value="$(arg gnss_baud)"/>
      <arg name="replay_file" value="$(arg gnss_replay_file)"/>
      <arg name="timestamp_mode" value="$(arg gnss_timestamp_mode)"/>
      <arg name="imu_timeshare_path" value="$(arg imu_timeshare_path)"/>
      <arg name="imu_anchor_warn_age_s"
           value="$(arg imu_anchor_warn_age_s)"/>
      <arg name="imu_anchor_max_age_s"
           value="$(arg imu_anchor_max_age_s)"/>
      <arg name="time_offset_s" value="$(arg gnss_time_offset_s)"/>
    </include>
  </group>

  <group if="$(arg enable_gnss_adapter)">
    <include file="$(find gnss_serial_driver)/launch/gnss_adapter.launch"/>
  </group>

  <group if="$(arg enable_uwb)">
    <include file="$(find uwb_serial_driver)/launch/uwb_serial.launch">
      <arg name="source" value="$(arg uwb_source)"/>
      <arg name="port" value="$(arg uwb_port)"/>
      <arg name="baud" value="$(arg uwb_baud)"/>
      <arg name="dtr" value="$(arg uwb_dtr)"/>
      <arg name="rts" value="$(arg uwb_rts)"/>
      <arg name="replay_file" value="$(arg uwb_replay_file)"/>
      <arg name="parser_mode" value="$(arg uwb_parser_mode)"/>
      <arg name="distance_lines_per_round"
           value="$(arg uwb_distance_lines_per_round)"/>
      <arg name="round_timeout_s" value="$(arg uwb_round_timeout_s)"/>
      <arg name="round_timestamp_policy"
           value="$(arg uwb_round_timestamp_policy)"/>
      <arg name="timestamp_mode" value="$(arg uwb_timestamp_mode)"/>
      <arg name="imu_timeshare_path" value="$(arg imu_timeshare_path)"/>
      <arg name="imu_anchor_warn_age_s"
           value="$(arg imu_anchor_warn_age_s)"/>
      <arg name="imu_anchor_max_age_s"
           value="$(arg imu_anchor_max_age_s)"/>
      <arg name="time_offset_s" value="$(arg uwb_time_offset_s)"/>
    </include>
  </group>
</launch>
