<launch>
  <param name="/use_sim_time" value="false"/>
  <arg name="enable_time_bridge" default="true"/>
  <arg name="enable_livox" default="true"/>
  <arg name="enable_camera" default="true"/>
  <arg name="enable_gnss" default="true"/>
  <arg name="enable_gnss_adapter" default="true"/>
  <arg name="enable_uwb" default="false"/>
  <arg name="mcu_input_mode" default="serial"/>
  <arg name="mcu_port" default="/dev/sensor_mcu"/>
  <arg name="mcu_baud" default="115200"/>
  <arg name="gnss_source" default="serial"/>
  <arg name="gnss_port" default="/dev/ttyUSB0"/>
  <arg name="gnss_baud" default="921600"/>
  <arg name="gnss_replay_file" default=""/>
  <arg name="uwb_source" default="serial"/>
  <arg name="uwb_port" default="/dev/ttyUSB0"/>
  <arg name="uwb_baud" default="115200"/>
  <arg name="uwb_dtr" default="true"/>
  <arg name="uwb_rts" default="false"/>
  <arg name="uwb_replay_file" default=""/>
  <arg name="uwb_parser_mode" default="distance_round5"/>
  <arg name="uwb_distance_lines_per_round" default="5"/>
  <arg name="uwb_round_timeout_s" default="2.0"/>
  <arg name="record_profile" default="both"/>
  <arg name="output_dir" default="/tmp"/>
  <arg name="bag_prefix" default="sensors"/>
  <arg name="sim_start_without_gnss_s" default="86400.0"/>
  <arg name="timeshare_path" default="$(env HOME)/timeshare"/>
  <arg name="imu_timeshare_path" default="$(env HOME)/timeshare_imu"/>
  <arg name="imu_anchor_enable" default="true"/>
  <arg name="imu_anchor_min_ready_samples" default="3"/>
  <arg name="imu_anchor_uncertainty_ns" default="10000000"/>
  <arg name="imu_anchor_max_stamp_step_s" default="0.1"/>
  <arg name="imu_anchor_warn_age_s" default="0.020"/>
  <arg name="imu_anchor_max_age_s" default="0.100"/>
  <arg name="uwb_timestamp_mode" default="livox_imu_anchor"/>
  <arg name="gnss_timestamp_mode" default="livox_imu_anchor"/>
  <arg name="uwb_time_offset_s" default="0.0"/>
  <arg name="gnss_time_offset_s" default="0.0"/>

  <include file="$(find sensor_recording_bringup)/launch/sensors_only.launch">
    <arg name="enable_time_bridge" value="$(arg enable_time_bridge)"/>
    <arg name="enable_livox" value="$(arg enable_livox)"/>
    <arg name="enable_camera" value="$(arg enable_camera)"/>
    <arg name="enable_gnss" value="$(arg enable_gnss)"/>
    <arg name="enable_gnss_adapter" value="$(arg enable_gnss_adapter)"/>
    <arg name="enable_uwb" value="$(arg enable_uwb)"/>
    <arg name="mcu_input_mode" value="$(arg mcu_input_mode)"/>
    <arg name="sim_start_without_gnss_s"
         value="$(arg sim_start_without_gnss_s)"/>
    <arg name="mcu_port" value="$(arg mcu_port)"/>
    <arg name="mcu_baud" value="$(arg mcu_baud)"/>
    <arg name="gnss_source" value="$(arg gnss_source)"/>
    <arg name="gnss_port" value="$(arg gnss_port)"/>
    <arg name="gnss_baud" value="$(arg gnss_baud)"/>
    <arg name="gnss_replay_file" value="$(arg gnss_replay_file)"/>
    <arg name="uwb_source" value="$(arg uwb_source)"/>
    <arg name="uwb_port" value="$(arg uwb_port)"/>
    <arg name="uwb_baud" value="$(arg uwb_baud)"/>
    <arg name="uwb_dtr" value="$(arg uwb_dtr)"/>
    <arg name="uwb_rts" value="$(arg uwb_rts)"/>
    <arg name="uwb_replay_file" value="$(arg uwb_replay_file)"/>
    <arg name="uwb_parser_mode" value="$(arg uwb_parser_mode)"/>
    <arg name="uwb_distance_lines_per_round"
         value="$(arg uwb_distance_lines_per_round)"/>
    <arg name="uwb_round_timeout_s" value="$(arg uwb_round_timeout_s)"/>
    <arg name="timeshare_path" value="$(arg timeshare_path)"/>
    <arg name="imu_timeshare_path" value="$(arg imu_timeshare_path)"/>
    <arg name="imu_anchor_enable" value="$(arg imu_anchor_enable)"/>
    <arg name="imu_anchor_min_ready_samples"
         value="$(arg imu_anchor_min_ready_samples)"/>
    <arg name="imu_anchor_uncertainty_ns"
         value="$(arg imu_anchor_uncertainty_ns)"/>
    <arg name="imu_anchor_max_stamp_step_s"
         value="$(arg imu_anchor_max_stamp_step_s)"/>
    <arg name="imu_anchor_warn_age_s"
         value="$(arg imu_anchor_warn_age_s)"/>
    <arg name="imu_anchor_max_age_s"
         value="$(arg imu_anchor_max_age_s)"/>
    <arg name="uwb_timestamp_mode" value="$(arg uwb_timestamp_mode)"/>
    <arg name="gnss_timestamp_mode" value="$(arg gnss_timestamp_mode)"/>
    <arg name="uwb_time_offset_s" value="$(arg uwb_time_offset_s)"/>
    <arg name="gnss_time_offset_s" value="$(arg gnss_time_offset_s)"/>
  </include>

  <node pkg="sensor_recording_bringup" type="session_recorder.py"
        name="session_recorder" output="screen" required="true">
    <param name="record_profile" value="$(arg record_profile)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="bag_prefix" value="$(arg bag_prefix)"/>
    <param name="enable_livox" value="$(arg enable_livox)"/>
    <param name="enable_camera" value="$(arg enable_camera)"/>
    <param name="enable_gnss" value="$(arg enable_gnss)"/>
    <param name="enable_uwb" value="$(arg enable_uwb)"/>
  </node>
</launch>
